{
  "manifest_version": 3,
  "version": "0.7.1",
  "name": "MeowCheats",
  "default_locale": "en",
  "description": "__MSG_description__",
  "permissions": [
    "storage",
    "scripting",
    "sidePanel",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_title": "MeowCheats",
    "default_popup": "data/popup/index.html",
    "default_icon": {
      "16": "data/icons/disabled/16.png",
      "32": "data/icons/disabled/32.png",
      "48": "data/icons/disabled/48.png"
    }
  },
  "homepage_url": "https://webextension.org/listing/always-active.html",
  "icons": {
    "16": "data/icons/16.png",
    "32": "data/icons/32.png",
    "48": "data/icons/48.png",
    "64": "data/icons/64.png",
    "128": "data/icons/128.png",
    "256": "data/icons/256.png",
    "512": "data/icons/512.png"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "options_ui": {
    "open_in_tab": true,
    "page": "data/options/index.html"
  },
  "commands": {
    "_execute_action": {},
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Show or hide the MeowCheats menu and enable always active"
    },
    "start-typing": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Start typing the saved draft and enable always active"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{4b7825da-0dd1-44f9-9717-bee5b2408af6}",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "data/popup/index.html?mode=side"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "data/popup/index.html"
      ],
      "matches": [
        "*://*/*"
      ],
      "use_dynamic_url": true
    }
  ]
}
