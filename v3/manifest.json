{
  "manifest_version": 3,
  "version": "1.0",
  "name": "MeowCheats",
  "default_locale": "en",
  "description": "__MSG_description__",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "optional_permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "action": {
    "default_title": "MeowCheats",
    "default_icon": {
      "16": "data/icons/disabled/16.png",
      "32": "data/icons/disabled/32.png",
      "48": "data/icons/disabled/48.png"
    }
  },
  "homepage_url": "https://github.com/aarushsharmawork/Project_Meow_Cheats",
  "icons": {
    "16": "data/icons/16.png",
    "32": "data/icons/32.png",
    "48": "data/icons/48.png",
    "64": "data/icons/64.png",
    "128": "data/icons/128.png",
    "256": "data/icons/256.png",
    "512": "data/icons/512.png"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [{
    "matches": ["https://gemini.google.com/*"],
    "all_frames": true,
    "run_at": "document_idle",
    "js": ["data/gemini-attachment.js"]
  }],
  "options_ui": {
    "open_in_tab": true,
    "page": "data/options/index.html"
  },
  "commands": {
    "_execute_action": {},
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Open or close the MeowCheats side panel"
    },
    "start-typing": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Start or stop typing the saved draft"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{4b7825da-0dd1-44f9-9717-bee5b2408af6}",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "data/popup/index.html?mode=side"
  }
}

